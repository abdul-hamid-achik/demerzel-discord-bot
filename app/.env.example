# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: scope slash commands to a single guild during development for instant updates
DISCORD_GUILD_ID=

# Translation providers (only the active one is required)
OPENAI_API_KEY=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# NeonDB (use the pooled connection string)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# openai | deepl | google
TRANSLATION_PROVIDER=openai

NODE_ENV=production
LOG_LEVEL=info

# Optional Redis (uncomment redis service in compose.yaml to use)
# REDIS_URL=redis://redis:6379
