# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: scope slash commands to a single guild during development for instant updates
DISCORD_GUILD_ID=

# Translation providers (only the active one is required)
OPENAI_API_KEY=
# Defaults to GPT-5.4 nano for lower-cost Discord chat and translation.
# Use gpt-5.4-mini if you want stronger responses at higher cost.
OPENAI_CHAT_MODEL=gpt-5.4-nano
OPENAI_TRANSLATION_MODEL=gpt-5.4-nano
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Tavily web-search (optional). When set, Demerzel can answer @mentions
# with up-to-date info pulled from the web.
TAVILY_API_KEY=

# NeonDB (use the pooled connection string)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# openai | deepl | google
TRANSLATION_PROVIDER=openai

NODE_ENV=production
LOG_LEVEL=info

# Optional Redis (uncomment redis service in compose.yaml to use)
# REDIS_URL=redis://redis:6379

# ─── Release announcements ──────────────────────────────────────────────────
# Optional. When release notes are present, Demerzel announces each release once.
# If no channel id is set, she tries to find a text channel named "home" in
# DISCORD_GUILD_ID.
DEMERZEL_ANNOUNCEMENT_CHANNEL_ID=
# Optional. New-member welcomes are enabled by default and use this channel,
# otherwise the announcement channel above, otherwise a text channel named
# "home" in DISCORD_GUILD_ID. Enable Server Members Intent in the Discord
# Developer Portal so Discord sends join events. Without that intent, welcomes
# can still work from Discord native join system messages if server system
# messages are enabled.
DEMERZEL_WELCOME_CHANNEL_ID=
# Optional. On join, Demerzel grants the new user access to all text and
# announcement channels by default. Set DEMERZEL_ONBOARDING_ACCESS_SCOPE to
# "configured" to use the older explicit channel/category behavior.
DEMERZEL_ONBOARDING_ACCESS_SCOPE=all_text
DEMERZEL_ONBOARDING_CHANNEL_IDS=
DEMERZEL_ONBOARDING_CATEGORY_ID=
# Optional. Never grant these text channel IDs or channels under these category
# IDs during onboarding. Use these for admin/private areas.
DEMERZEL_ONBOARDING_EXCLUDED_CHANNEL_IDS=
DEMERZEL_ONBOARDING_EXCLUDED_CATEGORY_IDS=
DEMERZEL_RELEASE_ID=
DEMERZEL_RELEASE_NOTES=
# Defaults to RELEASE_NOTES.md beside package.json.
DEMERZEL_RELEASE_NOTES_FILE=

# ─── StarWarrior CMS (via Void API) ──────────────────────────────────────────
# Set both to enable /cms-* slash commands. Leave blank to run as a
# translator-only bot.
#
# VOID_API_BASE_URL: StarWarrior CMS API base URL.
# Use http://localhost:3000/api during local StarWarrior dev, and
# https://www.starwarrior.org/api in prod.
VOID_API_BASE_URL=https://www.starwarrior.org/api

# VOID_API_KEY: shared secret. Must match BOT_API_KEY on the Void side.
# Copy the value from starwarrior/.env.local.
VOID_API_KEY=
